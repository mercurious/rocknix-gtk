+	/*
+	 * ROCKNIX-GTK / hotplug-window robustness (ETK):
+	 * the legacy encoder->crtc binding is unset while a DP modeset is
+	 * attaching or detaching the encoder, so vblank-counter and
+	 * scanout-position queries landing in that window fail with "no
+	 * encoder found for crtc" and the counter jumps to 0, corrupting
+	 * vblank accounting (seen through every plug-under-load freeze).
+	 * Fall back to the atomic state's encoder mask, which stays valid
+	 * across the transition.
+	 */
+	if (crtc->state) {
+		drm_for_each_encoder_mask(encoder, dev, crtc->state->encoder_mask)
+			return encoder;
+	}
+
 	return NULL;
 }
 
