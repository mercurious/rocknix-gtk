--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -31,6 +31,23 @@
 static bool psr_enabled = false;
 module_param(psr_enabled, bool, 0);
 MODULE_PARM_DESC(psr_enabled, "enable PSR for eDP and DP displays");
+
+/*
+ * ROCKNIX-GTK / DP plug-under-load compositor freeze (ETK):
+ * msm_dp_bridge_atomic_enable() takes event_mutex from the atomic commit
+ * tail, which already holds the CRTC commit lock -- while the HPD event
+ * thread holds the same mutex across full link training. A plug storm can
+ * therefore park the whole compositor behind an unbounded mutex_lock with
+ * no error and no timeout (drm_state_frozen_dpflap_20260807: both outputs
+ * frozen, atomic state all-healthy, unplug un-sticks it). Bound the
+ * commit-side acquisition; on expiry, log loudly and drop this enable --
+ * the DP output stays dark until the next hotplug-driven modeset instead
+ * of freezing both displays. 0 = stock unbounded behaviour.
+ */
+static unsigned int dp_enable_lock_timeout_ms = 10000;
+module_param(dp_enable_lock_timeout_ms, uint, 0644);
+MODULE_PARM_DESC(dp_enable_lock_timeout_ms,
+		 "Max ms an atomic enable waits for the DP event thread before dropping the enable (0 = wait forever)");
 
 #define HPD_STRING_SIZE 30
 
@@ -1609,7 +1626,29 @@
 	if (dp->is_edp)
 		msm_dp_hpd_plug_handle(msm_dp_display, 0);
 
-	mutex_lock(&msm_dp_display->event_mutex);
+	/*
+	 * ROCKNIX-GTK (ETK): bounded acquisition -- see
+	 * dp_enable_lock_timeout_ms at the top of this file. Dropping the
+	 * enable on expiry is the same failure class as the stock early
+	 * returns below (dark output, next hotplug modeset recovers); the
+	 * alternative is both displays frozen behind the commit lock.
+	 */
+	if (dp_enable_lock_timeout_ms) {
+		unsigned int waited_ms = 0;
+
+		while (!mutex_trylock(&msm_dp_display->event_mutex)) {
+			if (waited_ms >= dp_enable_lock_timeout_ms) {
+				DRM_ERROR("DP enable: event thread held event_mutex >%ums, dropping this enable (hpd_state=%d)\n",
+					  dp_enable_lock_timeout_ms,
+					  msm_dp_display->hpd_state);
+				return;
+			}
+			msleep(10);
+			waited_ms += 10;
+		}
+	} else {
+		mutex_lock(&msm_dp_display->event_mutex);
+	}
 	if (pm_runtime_resume_and_get(&dp->pdev->dev)) {
 		DRM_ERROR("failed to pm_runtime_resume\n");
 		mutex_unlock(&msm_dp_display->event_mutex);
